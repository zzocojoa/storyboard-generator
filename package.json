{
  "name": "storyboard-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.6.0 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:names": "node --import tsx scripts/check-required-tests.ts",
    "build:web": "vite build --logLevel warn",
    "test:e2e": "playwright test",
    "check:e2e": "npm run build:web && npm run test:e2e",
    "smoke": "node --import tsx scripts/runtime-smoke.ts",
    "start": "node --import tsx src/server/main.ts storyboard.config.json",
    "dev:web": "vite",
    "schemas:write": "node --import tsx scripts/write-schemas.ts",
    "schemas:check": "node --import tsx scripts/check-schemas.ts",
    "cli": "node --import tsx src/cli.ts",
    "codex-workbench": "node --import tsx src/codex/cli.ts storyboard.config.json",
    "check": "npm run typecheck && npm run typecheck:web && npm test && npm run test:names && npm run schemas:check && npm run build:web"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.1",
    "@fastify/static": "10.1.3",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/noto-serif-kr": "5.3.0",
    "fastify": "5.12.3",
    "pdfkit": "0.20.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.4",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/node": "24.10.1",
    "@types/pdfkit": "0.17.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
