{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contractVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "adapter": {
      "type": "string",
      "enum": [
        "native-v1",
        "production-v1"
      ]
    },
    "projectId": {
      "$ref": "#/$defs/__schema0"
    },
    "packageVersion": {
      "type": "string",
      "minLength": 1
    },
    "upstreamRevision": {
      "type": [
        "string",
        "null"
      ]
    },
    "timebase": {
      "type": "object",
      "properties": {
        "fpsNumerator": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 120000
        },
        "fpsDenominator": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 1001
        },
        "dropFrame": {
          "type": "boolean"
        },
        "sampleRate": {
          "type": "number",
          "enum": [
            44100,
            48000,
            96000
          ]
        },
        "startTimecode": {
          "type": "string",
          "pattern": "^\\d{2}:\\d{2}:\\d{2}[:;]\\d{2}$"
        }
      },
      "required": [
        "fpsNumerator",
        "fpsDenominator",
        "dropFrame",
        "sampleRate",
        "startTimecode"
      ],
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "properties": {
        "medium": {
          "type": "string",
          "enum": [
            "unspecified",
            "live-action",
            "ai",
            "hybrid"
          ]
        },
        "aspectWidth": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 16384
        },
        "aspectHeight": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 16384
        },
        "visualStyle": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "medium",
        "aspectWidth",
        "aspectHeight",
        "visualStyle"
      ],
      "additionalProperties": false
    },
    "files": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "authority": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema2"
      }
    }
  },
  "required": [
    "contractVersion",
    "adapter",
    "projectId",
    "packageVersion",
    "upstreamRevision",
    "timebase",
    "profile",
    "files",
    "authority"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^\\u0000-\\u001f]+$"
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "role": {
          "type": "string",
          "enum": [
            "native-data",
            "presentation",
            "screenplay",
            "reactions",
            "characters",
            "panel-cast",
            "scene-cards",
            "shooting",
            "edit",
            "subtitles",
            "readable",
            "manifest",
            "footprint",
            "reference"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "hashMode": {
          "type": "string",
          "enum": [
            "bytes-sha256",
            "sorted-json-sha256"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "role",
        "path",
        "required",
        "hashMode",
        "sha256"
      ],
      "additionalProperties": false
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string",
          "enum": [
            "timeline",
            "units",
            "people",
            "scenes",
            "screen-text",
            "panel-turns"
          ]
        },
        "fileIds": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "field",
        "fileIds"
      ],
      "additionalProperties": false
    }
  }
}
