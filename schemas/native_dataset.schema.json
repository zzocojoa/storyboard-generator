{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "projectId": {
      "$ref": "#/$defs/__schema0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema0"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "character",
              "panel",
              "presenter",
              "narrator"
            ]
          },
          "visualDescription": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "role",
          "kind",
          "visualDescription"
        ],
        "additionalProperties": false
      }
    },
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema0"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "scenes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "segments": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema2"
      }
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema0"
          },
          "segmentId": {
            "$ref": "#/$defs/__schema0"
          },
          "order": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "kind": {
            "type": "string",
            "enum": [
              "ACTION",
              "DIALOGUE",
              "NARRATION",
              "PANEL",
              "SCREEN_TEXT",
              "CHAT",
              "NOTE",
              "SOUND",
              "MUSIC"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "speakerId": {
            "anyOf": [
              {
                "$ref": "#/$defs/__schema0"
              },
              {
                "type": "null"
              }
            ]
          },
          "informationIds": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema0"
            }
          }
        },
        "required": [
          "id",
          "segmentId",
          "order",
          "kind",
          "text",
          "speakerId",
          "informationIds"
        ],
        "additionalProperties": false
      }
    },
    "informationRules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema0"
          },
          "notBeforeMs": {
            "$ref": "#/$defs/__schema3"
          },
          "segmentId": {
            "$ref": "#/$defs/__schema0"
          },
          "notBeforeUnitId": {
            "anyOf": [
              {
                "$ref": "#/$defs/__schema0"
              },
              {
                "type": "null"
              }
            ]
          },
          "notBeforeUnitOrder": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "precision": {
            "type": "string",
            "enum": [
              "exact-time",
              "unit-order",
              "segment-start"
            ]
          }
        },
        "required": [
          "id",
          "notBeforeMs"
        ],
        "additionalProperties": false
      }
    },
    "instructions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema0"
          },
          "segmentId": {
            "$ref": "#/$defs/__schema0"
          },
          "kind": {
            "type": "string",
            "enum": [
              "shooting",
              "edit",
              "music",
              "ambience"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "segmentId",
          "kind",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "textPlacements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema0"
          },
          "segmentId": {
            "$ref": "#/$defs/__schema0"
          },
          "startMs": {
            "$ref": "#/$defs/__schema3"
          },
          "endMs": {
            "anyOf": [
              {
                "$ref": "#/$defs/__schema3"
              },
              {
                "type": "null"
              }
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "unitId": {
            "anyOf": [
              {
                "$ref": "#/$defs/__schema0"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "segmentId",
          "startMs",
          "endMs",
          "text",
          "unitId"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "projectId",
    "title",
    "people",
    "locations",
    "scenes",
    "segments",
    "units",
    "informationRules",
    "instructions",
    "textPlacements"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^\\u0000-\\u001f]+$"
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "storyLocationId": {
          "anyOf": [
            {
              "$ref": "#/$defs/__schema0"
            },
            {
              "type": "null"
            }
          ]
        },
        "declaredCastIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "id",
        "title",
        "storyLocationId",
        "declaredCastIds"
      ],
      "additionalProperties": false
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "sceneId": {
          "$ref": "#/$defs/__schema0"
        },
        "mode": {
          "type": "string",
          "minLength": 1
        },
        "startMs": {
          "$ref": "#/$defs/__schema3"
        },
        "endMs": {
          "$ref": "#/$defs/__schema3"
        },
        "timingStatus": {
          "type": "string",
          "enum": [
            "fixed",
            "proposed"
          ]
        },
        "reactionId": {
          "anyOf": [
            {
              "$ref": "#/$defs/__schema0"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "sceneId",
        "mode",
        "startMs",
        "endMs",
        "timingStatus",
        "reactionId"
      ],
      "additionalProperties": false
    },
    "__schema3": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
