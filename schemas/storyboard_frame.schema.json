{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/__schema0"
    },
    "shotId": {
      "$ref": "#/$defs/__schema0"
    },
    "offsetMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "role": {
      "type": "string",
      "enum": [
        "start",
        "end",
        "key"
      ]
    },
    "description": {
      "type": "string"
    },
    "imageAssetId": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema0"
        },
        {
          "type": "null"
        }
      ]
    },
    "visualReview": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "rejected"
      ]
    }
  },
  "required": [
    "id",
    "shotId",
    "offsetMs",
    "role",
    "description",
    "imageAssetId",
    "visualReview"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^\\u0000-\\u001f]+$"
    }
  }
}
