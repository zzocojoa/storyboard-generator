{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "operationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "requestId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "logicalKey": {
      "$ref": "#/$defs/__schema0"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "proposal",
        "image",
        "speech"
      ]
    },
    "targetId": {
      "type": "string",
      "minLength": 1
    },
    "basisHash": {
      "$ref": "#/$defs/__schema0"
    },
    "generationBuildSha256": {
      "$ref": "#/$defs/__schema0"
    },
    "resultSha256": {
      "$ref": "#/$defs/__schema0"
    },
    "generationRecordSha256": {
      "$ref": "#/$defs/__schema0"
    },
    "resultProjectSha256": {
      "$ref": "#/$defs/__schema0"
    },
    "startRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "owner": {
      "type": "object",
      "properties": {
        "transactionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "pid": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "transactionId",
        "host",
        "pid"
      ],
      "additionalProperties": false
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "version",
    "operationId",
    "requestId",
    "logicalKey",
    "projectId",
    "kind",
    "targetId",
    "basisHash",
    "generationBuildSha256",
    "resultSha256",
    "generationRecordSha256",
    "resultProjectSha256",
    "startRevision",
    "owner",
    "createdAt"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
