{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "formatVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "sourceFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "packageVersion": {
      "type": "string",
      "minLength": 1
    },
    "timebase": {
      "type": "object",
      "properties": {
        "fpsNumerator": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 120000
        },
        "fpsDenominator": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 1001
        },
        "dropFrame": {
          "type": "boolean"
        },
        "sampleRate": {
          "type": "number",
          "enum": [
            44100,
            48000,
            96000
          ]
        },
        "startTimecode": {
          "type": "string",
          "pattern": "^\\d{2}:\\d{2}:\\d{2}[:;]\\d{2}$"
        }
      },
      "required": [
        "fpsNumerator",
        "fpsDenominator",
        "dropFrame",
        "sampleRate",
        "startTimecode"
      ],
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "properties": {
        "medium": {
          "type": "string",
          "enum": [
            "unspecified",
            "live-action",
            "ai",
            "hybrid"
          ]
        },
        "aspectWidth": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 16384
        },
        "aspectHeight": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 16384
        },
        "visualStyle": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "medium",
        "aspectWidth",
        "aspectHeight",
        "visualStyle"
      ],
      "additionalProperties": false
    },
    "bindings": {
      "type": "object",
      "properties": {
        "people": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "scenes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "units": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "people",
        "scenes",
        "units"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "formatVersion",
    "sourceFingerprint",
    "packageVersion",
    "timebase",
    "profile",
    "bindings"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "targetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[^\\u0000-\\u001f]+$"
        }
      },
      "required": [
        "key",
        "targetId"
      ],
      "additionalProperties": false
    }
  }
}
