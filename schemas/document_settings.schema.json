{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "formatVersion": {
      "type": "string",
      "enum": [
        "1.0.0",
        "1.1.0",
        "1.2.0"
      ]
    },
    "sourceFingerprint": {
      "$ref": "#/$defs/__schema0"
    },
    "packageVersion": {
      "type": "string",
      "minLength": 1
    },
    "timebase": {
      "type": "object",
      "properties": {
        "fpsNumerator": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 120000
        },
        "fpsDenominator": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 1001
        },
        "dropFrame": {
          "type": "boolean"
        },
        "sampleRate": {
          "type": "number",
          "enum": [
            44100,
            48000,
            96000
          ]
        },
        "startTimecode": {
          "type": "string",
          "pattern": "^\\d{2}:\\d{2}:\\d{2}[:;]\\d{2}$"
        }
      },
      "required": [
        "fpsNumerator",
        "fpsDenominator",
        "dropFrame",
        "sampleRate",
        "startTimecode"
      ],
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "properties": {
        "medium": {
          "type": "string",
          "enum": [
            "unspecified",
            "live-action",
            "ai",
            "hybrid"
          ]
        },
        "aspectWidth": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 16384
        },
        "aspectHeight": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 16384
        },
        "visualStyle": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "medium",
        "aspectWidth",
        "aspectHeight",
        "visualStyle"
      ],
      "additionalProperties": false
    },
    "bindings": {
      "type": "object",
      "properties": {
        "people": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        "scenes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        "units": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        }
      },
      "required": [
        "people",
        "scenes",
        "units"
      ],
      "additionalProperties": false
    },
    "reviewAudit": {
      "type": "object",
      "properties": {
        "sourceFingerprint": {
          "$ref": "#/$defs/__schema0"
        },
        "preset": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "fields": {
                  "type": "object",
                  "properties": {
                    "fps": {
                      "type": "string"
                    },
                    "sampleRate": {
                      "type": "string"
                    },
                    "width": {
                      "type": "string"
                    },
                    "height": {
                      "type": "string"
                    },
                    "startTimecode": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "fps",
                    "sampleRate",
                    "width",
                    "height",
                    "startTimecode"
                  ],
                  "additionalProperties": false
                },
                "createdAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                }
              },
              "required": [
                "id",
                "name",
                "fields",
                "createdAt"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "entries": {
          "maxItems": 3000,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema3"
          }
        }
      },
      "required": [
        "sourceFingerprint",
        "preset",
        "entries"
      ],
      "additionalProperties": false
    },
    "identityEvidence": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "const": "production-characters-v1"
        },
        "projectId": {
          "$ref": "#/$defs/__schema2"
        },
        "sourceFingerprint": {
          "$ref": "#/$defs/__schema0"
        },
        "characters": {
          "$ref": "#/$defs/__schema5"
        },
        "footprint": {
          "$ref": "#/$defs/__schema5"
        }
      },
      "required": [
        "format",
        "projectId",
        "sourceFingerprint",
        "characters",
        "footprint"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "formatVersion",
    "sourceFingerprint",
    "packageVersion",
    "timebase",
    "profile",
    "bindings"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "targetId": {
          "$ref": "#/$defs/__schema2"
        }
      },
      "required": [
        "key",
        "targetId"
      ],
      "additionalProperties": false
    },
    "__schema2": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^\\u0000-\\u001f]+$"
    },
    "__schema3": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string",
          "enum": [
            "people",
            "scenes",
            "units",
            "production"
          ]
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "type": "string",
          "enum": [
            "document",
            "inference",
            "recommendation",
            "preset",
            "user",
            "identity-document"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "evidence": {
          "maxItems": 12,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema4"
          }
        },
        "confirmed": {
          "type": "boolean"
        },
        "reviewId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "field",
        "key",
        "value",
        "origin",
        "reason",
        "evidence",
        "confirmed",
        "reviewId",
        "model"
      ],
      "additionalProperties": false
    },
    "__schema4": {
      "type": "object",
      "properties": {
        "fileId": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": [
        "fileId",
        "locator",
        "quote"
      ],
      "additionalProperties": false
    },
    "__schema5": {
      "type": "object",
      "properties": {
        "sha256": {
          "$ref": "#/$defs/__schema0"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 262144
        }
      },
      "required": [
        "sha256",
        "content"
      ],
      "additionalProperties": false
    }
  }
}
